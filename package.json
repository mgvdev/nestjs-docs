    "react-server-dom-webpack": "^19.2.7",
    "waku": "1.0.0-beta.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.0",
